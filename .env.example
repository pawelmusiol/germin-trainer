# ==============================================================================
# Garmin AI Trainer - Environment Configuration Example
# Copy this file to .env before starting the server.
# ==============================================================================

# Server Environment
PORT=3001
NODE_ENV=development
API_PREFIX=/api
CLIENT_ORIGIN=http://localhost:8081

# PostgreSQL Database Connection (Supabase / Neon)
# Direct or pooled connection string:
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require"
# Optional direct connection for migrations (Supabase connection pooler setup):
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]?sslmode=require"

# JWT Authentication (R3)
# Secret key used for signing JSON Web Tokens (min 32 characters recommended)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# AES-256-GCM Garmin Token Encryption (R3)
# 32-byte hexadecimal string (64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GARMIN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google Gemini API (Phase 3 placeholder)
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# Garmin Connect OAuth / Consumer Keys (Phase 2 placeholder)
GARMIN_CONSUMER_KEY=""
GARMIN_CONSUMER_SECRET=""
